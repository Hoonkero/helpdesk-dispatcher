# --- Предохранитель -----------------------------------------------------
# true = НИ ОДНО действие не уходит во внешний мир (ни реакций, ни сообщений).
# Пока идёт разработка и тестирование — не выключать.
SAFE_MODE=true

# --- Режим работы -------------------------------------------------------
# shadow  = бот только предлагает действия, оператор подтверждает в UI
# assisted = автоматические реакции, сообщения только с подтверждением
# auto    = полный автопилот (включать по одной категории)
DISPATCHER_MODE=shadow

# --- MAX ----------------------------------------------------------------
MAX_TRANSPORT=fake                 # fake (заглушка) | sandbox (стенд) | playwright (живой MAX)
MAX_WEB_URL=https://web.max.ru
MAX_PROFILE_DIR=./data/max-profile # persistent browser profile (сессия)
MAX_POLL_INTERVAL=15               # секунд между опросами
MAX_WATCH_CHATS=ИТ Заявки              # чаты-заявки, через запятую
MAX_IGNORE_MUTED=true              # приглушённые чаты = нерабочие
MAX_REACTION_SEEN=👌
MAX_REACTION_DONE=✔️
MAX_MAX_ACTIONS_PER_HOUR=60        # антибан-лимит

# --- Локальная LLM ------------------------------------------------------
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:1234/v1   # LM Studio; Ollama: http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=60

# --- Aspia --------------------------------------------------------------
ASPIA_ENABLED=false
ASPIA_CLIENT_PATH=
ASPIA_DRY_RUN=true

# --- Эскалация ----------------------------------------------------------
ESCALATION_CONTACT=Вторая линия поддержки   # куда пересылать заблокированные учётки

DATABASE_URL=sqlite:///./data/dezhurny.db
